# =============================================================
# AI Resume Backend — Environment Variables for Railway
# Copy these into your Railway project's "Variables" tab.
# DO NOT commit real values to git.
# =============================================================

# --- Active LLM Provider ---
LLM_PROVIDER=google/gemini-2.5-flash

# --- API Keys ---
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Redis (Railway Redis plugin auto-injects REDIS_URL) ---
# If using Railway Redis plugin, it sets REDIS_URL automatically.
# Override REDIS_SEMANTIC_URL to the same value (same instance, different DB index):
# REDIS_URL=redis://...  ← auto-injected by Railway Redis plugin
REDIS_SEMANTIC_URL=      # leave blank — set manually in Railway if needed

# --- Cache settings ---
CACHE_TTL_DAYS=7
SEMANTIC_DISTANCE_THRESHOLD=0.10

# --- Port (Railway injects this automatically, do not change) ---
# PORT=8080
